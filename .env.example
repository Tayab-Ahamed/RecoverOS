# Copy to .env and fill in. .env is gitignored from the first commit.

# ---- application ----
APP_ENV=local
APP_VERSION=0.1.0
GIT_SHA=unknown
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ---- data stores ----
DATABASE_URL=postgresql+psycopg://recoveros:recoveros@db:5432/recoveros
REDIS_URL=redis://redis:6379/0

# ---- payment provider ----
# mock     = fully offline, no credentials, deterministic. Default.
# razorpay = live test-mode calls. Requires all three values below.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- reasoning ----
# mock      = deterministic rule-based narratives, no network. Default.
# anthropic = live model calls. Requires ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# ---- security ----
# No default is supplied on purpose. Production boot fails if this is weak.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ---- local development affordances ----
# Allows delivering a correctly signed mock webhook without a public tunnel.
# Must be false in production; boot fails otherwise.
ENABLE_LOCAL_WEBHOOK_REPLAY=true

# ---- optional workflow automation ----
N8N_WEBHOOK_URL=
N8N_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173
